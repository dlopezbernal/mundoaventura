# =====================================================================
#  ARCHIVO DE EJEMPLO DE VARIABLES DE ENTORNO
# ---------------------------------------------------------------------
#  Copia este archivo a ".env" (sin .example) y ajústalo a tu máquina.
#  El .env real NO se sube a git (está en .gitignore).
#
#      Windows PowerShell:   Copy-Item .env.example .env
#      Linux / macOS:        cp .env.example .env
# =====================================================================


# ─── FRONTEND ───────────────────────────────────────────────────────
# URL donde escucha el backend FastAPI. El frontend Flet le hará las
# peticiones a esta dirección.
#   • Backend en TU ordenador (local):   http://127.0.0.1:8000
BACKEND_URL=http://127.0.0.1:8000


# ─── BACKEND (Replicate.com) ────────────────────────────────────────
# Token de tu cuenta de Replicate. Créalo en:
#   https://replicate.com/account/api-tokens
# Sin este token el backend NO puede generar imágenes.
REPLICATE_API_TOKEN=

# Modelo de texto-a-imagen que genera la escena (personaje + ubicación).
# Por defecto FLUX schnell: rápido y barato.
REPLICATE_MODEL=black-forest-labs/flux-schnell

# Modelo de EDICIÓN para el modo "Usar mi foto" (estiliza la foto + añade el
# personaje). FLUX Kontext pro es buen equilibrio; "max" estiliza más fuerte.
REPLICATE_EDIT_MODEL=black-forest-labs/flux-kontext-pro

# Proporción de la imagen ("1:1", "16:9", "9:16", "4:3"...).
IMG_ASPECT_RATIO=16:9

# Formato del archivo de salida ("png", "jpg", "webp").
IMG_OUTPUT_FORMAT=png

# Pasos de difusión. FLUX schnell rinde óptimo con 4 (su máximo). No subir.
IMG_NUM_STEPS=4

# Límite de tokens del codificador CLIP de FLUX (FLUX usa CLIP, corto, + T5, largo).
# Si el prompt lo supera, el backend avisa por consola ([GEN] ⚠️): CLIP recorta el
# final, pero T5 lo lee igual. Por eso el prompt pone lo importante al principio.
CLIP_TOKEN_LIMIT=77


# ─── BACKEND (Conversación / RAG) ───────────────────────────────────
# LLM que responde como el personaje, vía Replicate (usa el mismo token de arriba).
REPLICATE_LLM_MODEL=meta/meta-llama-3-8b-instruct

# Longitud máxima de la respuesta (en tokens) y nº de fichas recuperadas por pregunta.
LLM_MAX_TOKENS=300
RAG_TOP_K=3

# Evaluator: cómo se decide si una pregunta se responde con el RAG o no.
#   umbral  → solo distancia (gratis, sin LLM)
#   llm     → solo el LLM-juez (más listo, pero cuesta una llamada extra)
#   hibrido → el umbral resuelve lo claro y el LLM solo desempata lo dudoso (recomendado)
EVALUATOR_MODE=hibrido
# Umbrales de distancia coseno (0=idéntico, 2=opuesto). Calíbralos con DEBUG (d=...).
#   distancia <= BAJO → RAG seguro · distancia >= ALTO → GENERAL seguro · en medio → dudoso
EVALUATOR_UMBRAL_BAJO=0.75
EVALUATOR_UMBRAL_ALTO=0.95

# ─── BACKEND (Traducción / DeepL) — OBLIGATORIO ─────────────────────
# Los documentos están en inglés (mejores embeddings). Traducimos la pregunta
# ES→EN con DeepL antes de buscar. Es OBLIGATORIO: sin clave, la recuperación
# falla (recupera fichas equivocadas) y el chat no responde.
# Clave gratis (500.000 chars/mes) en: https://www.deepl.com/pro-api
DEEPL_API_KEY=

# Carpeta donde ChromaDB guarda su índice vectorial (se crea sola).
CHROMA_DIR=backend/chroma_db

# Troceado de documentos (chunking), en caracteres:
#   CHUNK_SIZE    → tamaño de cada fragmento
#   CHUNK_OVERLAP → caracteres que se repiten entre fragmentos (solape)
CHUNK_SIZE=800
CHUNK_OVERLAP=120


# ─── BACKEND (Voz / ElevenLabs) ─────────────────────────────────────
# Clave de ElevenLabs para transcribir la voz del niño (Scribe) y dar voz a la
# respuesta del personaje (Flash). Pago por uso. https://elevenlabs.io
ELEVENLABS_API_KEY=
# Modelos (no suele hacer falta cambiarlos).
ELEVENLABS_STT_MODEL=scribe_v1
ELEVENLABS_TTS_MODEL=eleven_turbo_v2_5
# Formato del audio de la respuesta (mp3) e idioma de la transcripción.
TTS_OUTPUT_FORMAT=mp3_44100_128
STT_LANG=es


# ─── DESARROLLO ─────────────────────────────────────────────────────
# Si está activo (true), se habilitan herramientas de diagnóstico que NO ve el niño:
#   • el origen de cada respuesta del chat se imprime en la CONSOLA DEL BACKEND (uvicorn):
#       🟢 [RAG] = fundamentada en la enciclopedia · 🟡 [GENERAL] = conocimiento del modelo.
#   • aparece el botón "🔌 Probar conexión" en la cabecera del frontend (consulta /health).
# Para la versión final del usuario, déjalo en false (interfaz limpia, sin trazas).
DEBUG=false
