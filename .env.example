# =====================================================================
#  ARCHIVO DE EJEMPLO DE VARIABLES DE ENTORNO
# ---------------------------------------------------------------------
#  Copia este archivo a ".env" (sin .example) y ajústalo a tu máquina.
#  El .env real NO se sube a git (está en .gitignore).
#
#      Windows PowerShell:   Copy-Item .env.example .env
#      Linux / macOS:        cp .env.example .env
# =====================================================================


# ─── FRONTEND ───────────────────────────────────────────────────────
# Este .env es SOLO del backend. La SPA React tiene su propia configuración en
# frontend-react/.env: VITE_BACKEND_URL (URL del backend) y VITE_DEBUG (botón de
# diagnóstico). Ver frontend-react/.env.example.


# ─── BACKEND (CORS) ─────────────────────────────────────────────────
# Orígenes (separados por comas) desde los que un navegador puede llamar a
# la API, p. ej. donde sirves la SPA:
#   CORS_ORIGINS=http://localhost:5173,https://miapp.ejemplo.com
# Sin definir (o vacío) se permite CUALQUIER origen ("*"): cómodo en
# desarrollo; restríngelo si expones el backend a internet (túnel, etc.).
CORS_ORIGINS=


# ─── BACKEND (Replicate.com) ────────────────────────────────────────
# Token de tu cuenta de Replicate. Créalo en:
#   https://replicate.com/account/api-tokens
# Sin este token el backend NO puede generar imágenes.
REPLICATE_API_TOKEN=

# Modelo de texto-a-imagen que genera la escena (personaje + ubicación).
# Por defecto FLUX schnell: rápido y barato.
REPLICATE_MODEL=black-forest-labs/flux-schnell

# Modelo de EDICIÓN para el modo "Usar mi foto" (estiliza la foto + añade el
# personaje). FLUX Kontext pro es buen equilibrio; "max" estiliza más fuerte.
REPLICATE_EDIT_MODEL=black-forest-labs/flux-kontext-pro

# Proporción de la imagen ("1:1", "16:9", "9:16", "4:3"...).
IMG_ASPECT_RATIO=16:9

# Formato del archivo de salida ("png", "jpg", "webp"). webp pesa mucho menos que png
# (la escena viaja en base64 dentro del JSON); el frontend deduce el tipo de los bytes.
IMG_OUTPUT_FORMAT=webp

# Pasos de difusión. FLUX schnell rinde óptimo con 4 (su máximo). No subir.
IMG_NUM_STEPS=4

# Límite de tokens del codificador CLIP de FLUX (FLUX usa CLIP, corto, + T5, largo).
# Si el prompt lo supera, el backend avisa por consola ([GEN] ⚠️): CLIP recorta el
# final, pero T5 lo lee igual. Por eso el prompt pone lo importante al principio.
CLIP_TOKEN_LIMIT=77


# ─── BACKEND (Conversación / RAG) ───────────────────────────────────
# Capa de proveedor de LLM (Hito 5): todas las llamadas pasan por llm_service, que
# despacha por LLM_PROVIDER. Cambiar de proveedor es cambiar config, no código.
#   replicate → línea base (usa el REPLICATE_API_TOKEN de arriba)
#   openai    → endpoint openai-compatible (Groq, Mistral, OpenRouter, Ollama local…)
LLM_PROVIDER=replicate
# Modelo en el proveedor activo. Por defecto = el de Replicate (Llama 3 8B), reproduce
# la línea base. Con provider=openai, p. ej. "llama3" (Ollama) o "llama-3.1-8b-instant".
LLM_MODEL=meta/meta-llama-3-8b-instruct
REPLICATE_LLM_MODEL=meta/meta-llama-3-8b-instruct
# Solo si LLM_PROVIDER=openai: URL del endpoint y clave (Ollama local no necesita clave).
#   Ollama: http://localhost:11434/v1   ·   Groq: https://api.groq.com/openai/v1
LLM_BASE_URL=
LLM_API_KEY=
LLM_TIMEOUT=60

# Longitud máxima de la respuesta (en tokens) y nº de fichas recuperadas por pregunta.
LLM_MAX_TOKENS=300
RAG_TOP_K=3

# Evaluator: cómo se decide si una pregunta se responde con el RAG o no.
#   umbral  → solo distancia (gratis, sin LLM)
#   llm     → solo el LLM-juez (más listo, pero cuesta una llamada extra)
#   hibrido → el umbral resuelve lo claro y el LLM solo desempata lo dudoso (recomendado)
EVALUATOR_MODE=hibrido
# Umbrales de distancia coseno (0=idéntico, 2=opuesto). Calíbralos con DEBUG (d=...).
#   distancia <= BAJO → RAG seguro · distancia >= ALTO → GENERAL seguro · en medio → dudoso
EVALUATOR_UMBRAL_BAJO=0.75
EVALUATOR_UMBRAL_ALTO=0.95

# Si el Evaluator decide GENERAL (las fichas no sirven), ¿el personaje responde con
# su conocimiento propio (llamada extra al LLM) o con un mensaje fijo de "no lo sé"
# sin llamar a ningún modelo? true = comportamiento de siempre. false = chat anclado
# solo a tus documentos (el mensaje fijo se edita en el menú, ajuste
# MENSAJE_SIN_INFORMACION, categoría "prompts").
PERMITIR_CONOCIMIENTO_GENERAL=true

# ─── BACKEND (Traducción / DeepL) — OBLIGATORIO ─────────────────────
# Los documentos están en inglés (mejores embeddings). Traducimos la pregunta
# ES→EN con DeepL antes de buscar. Es OBLIGATORIO: sin clave, la recuperación
# falla (recupera fichas equivocadas) y el chat no responde.
# Clave gratis (500.000 chars/mes) en: https://www.deepl.com/pro-api
DEEPL_API_KEY=

# Carpeta donde ChromaDB guarda su índice vectorial (se crea sola).
CHROMA_DIR=backend/chroma_db

# Troceado de documentos (chunking), en caracteres:
#   CHUNK_SIZE    → tamaño de cada fragmento
#   CHUNK_OVERLAP → caracteres que se repiten entre fragmentos (solape)
CHUNK_SIZE=800
CHUNK_OVERLAP=120


# ─── BACKEND (Voz / ElevenLabs) ─────────────────────────────────────
# Clave de ElevenLabs para transcribir la voz del niño (Scribe) y dar voz a la
# respuesta del personaje (Flash). Pago por uso. https://elevenlabs.io
ELEVENLABS_API_KEY=
# Modelos (no suele hacer falta cambiarlos).
ELEVENLABS_STT_MODEL=scribe_v1
ELEVENLABS_TTS_MODEL=eleven_multilingual_v2
# Formato del audio de la respuesta (mp3) e idioma de la transcripción.
TTS_OUTPUT_FORMAT=mp3_44100_128
STT_LANG=es


# ─── BACKEND (STT: transcripción seleccionable, Hito 7) ─────────────
# Proveedor de transcripción (voz→texto). Cambiar de proveedor es cambiar config,
# no código (igual que LLM_PROVIDER en H5). Con STT local, la voz del niño NUNCA
# sale del PC (privacidad/RGPD).
#   elevenlabs : Scribe en la nube (por defecto; usa ELEVENLABS_API_KEY).
#   local      : faster-whisper en tu PC. Requiere el extra: uv sync --extra stt-local
#                (+ DLLs de cuBLAS/cuDNN en Windows, ver README). Si no carga, cae a nube.
#   groq       : Whisper en Groq (nube). Necesita GROQ_API_KEY.
STT_PROVIDER=elevenlabs
# Solo si STT_PROVIDER=local (faster-whisper):
STT_LOCAL_MODEL=large-v3-turbo
STT_LOCAL_DEVICE=cuda
STT_LOCAL_COMPUTE=int8
# Solo si STT_PROVIDER=groq:
GROQ_API_KEY=
GROQ_STT_MODEL=whisper-large-v3
GROQ_BASE_URL=https://api.groq.com/openai/v1


# ─── BACKEND (Personajes) ───────────────────────────────────────────
# Tope máximo de personajes en el catálogo (activos + inactivos). Es un límite
# FIJO de despliegue: a diferencia del resto de ajustes, NO se puede cambiar
# desde el menú de configuración (⚙️ → Personajes) — solo editando este .env
# y reiniciando el backend.
MAX_PERSONAJES=10

# Tope de niños (hermanos) por cuenta de familia. Mismo carácter que el anterior:
# límite FIJO de despliegue, no editable desde la app. La pantalla de perfil y el
# gate de bienvenida deshabilitan "Añadir" al alcanzarlo.
MAX_NINOS=4


# ─── BLINDAJE OPERATIVO / TÚNEL (Hito 2) ────────────────────────────
# Código de acceso del túnel: si se define, los endpoints del niño (chat,
# generación, voz) exigen la cabecera X-Access-Code con este valor. Es un candado
# LIGERO contra el escaneo automático de la URL pública (ngrok/Colab), no
# autenticación fuerte. Vacío = candado DESACTIVADO (cómodo en local). Debe
# coincidir con VITE_ACCESS_CODE en frontend-react/.env.
ACCESS_CODE=

# Sesión de familia obligatoria en los endpoints CAROS del niño (chat, generación,
# voz). Complementa a ACCESS_CODE, que NO es autenticación: viaja incrustado en el
# bundle de la SPA (VITE_ACCESS_CODE), así que cualquiera que abra las DevTools lo
# lee y puede llamar a /api/generate, /api/ask y /api/transcribe con curl — es decir,
# gastar tu saldo de Replicate/ElevenLabs.
#   true (por defecto): esos tres endpoints exigen ADEMÁS un X-Family-Token válido.
#         No añade fricción al niño: la app ya obliga a iniciar sesión antes de jugar
#         y el frontend manda el token en todas las peticiones.
#   false: comportamiento previo (solo ACCESS_CODE). Útil para trastear desde /docs o
#         para un banco de pruebas que ataque la API por HTTP.
# Es un toggle de DESPLIEGUE: a propósito NO se puede desactivar desde el menú de
# configuración (la autenticación no debería apagarse desde la UI).
EXIGIR_SESION_FAMILIA=true

# Timeouts (segundos) de las llamadas a los proveedores. Sin timeout, una llamada
# colgada deja la petición esperando para siempre.
REPLICATE_TIMEOUT=120
ELEVENLABS_TIMEOUT=60
DEEPL_TIMEOUT=10

# Reintentos ante errores TRANSITORIOS (429/5xx, timeouts) con backoff exponencial
# + jitter. HTTP_MAX_INTENTOS = nº TOTAL de intentos (3 = 1 original + 2 reintentos).
# Solo aplica a Replicate y ElevenLabs (DeepL ya reintenta internamente).
HTTP_MAX_INTENTOS=3
HTTP_BACKOFF_BASE=0.5
HTTP_BACKOFF_MAX=8

# Tamaño máximo de las subidas (MB). Por encima → HTTP 413 (no 500).
MAX_IMAGEN_MB=10
MAX_AUDIO_MB=5
MAX_DOCUMENTO_MB=20

# Rate limit por IP (formato "N/unidad"): generoso para el chat, restrictivo para la
# imagen (lo caro). Al superarlo, el personaje responde "en personaje" (chat) o se
# devuelve un aviso amable (imagen/voz), nunca un 429 crudo.
RATE_LIMIT_ASK=30/minute
RATE_LIMIT_GENERATE=10/minute
RATE_LIMIT_TRANSCRIBE=20/minute

# Tope DIARIO de generaciones de imagen (por día natural, en SQLite). Techo duro de
# coste, complementario al rate limit por minuto. <= 0 = sin tope.
MAX_IMAGENES_DIA=50

# Mensaje amable (en personaje) cuando se agota el cupo o el rate limit.
MENSAJE_LIMITE=¡Uf! Mi máquina del tiempo necesita descansar un ratito. Vuelve a intentarlo dentro de un momento, ¿vale?


# ─── VERIFICACIÓN DE CORREO (cuentas de familia, Hito 9.2) ──────────
# Al dar de alta una familia se puede exigir VERIFICAR el correo del adulto con un
# código de un solo uso (OTP) enviado por email — el patrón habitual en internet, y
# refuerza el consentimiento parental. Es un TOGGLE de despliegue:
#   false (por defecto): el alta es inmediata, sin correo. Cómodo en local y para
#                        el tribunal (no hace falta montar un servidor SMTP).
#   true : el alta queda "pendiente" hasta teclear el código enviado.
EMAIL_VERIFICACION=false

# Envío por SMTP. Si SMTP_HOST está vacío —o con DEBUG=true— el código NO se envía: se
# ESCRIBE EN EL LOG del backend (fallback de consola), para poder probar el flujo
# completo sin un servidor de correo real.
#
# En producción se usa BREVO como servicio transaccional, enviando desde el dominio
# propio de la app: una dirección de correo personal en el "De" resta credibilidad, y
# los proveedores de correo gratuito limitan el envío automatizado. Valores del relé:
#   SMTP_HOST=smtp-relay.brevo.com   ·   SMTP_PORT=587   ·   SMTP_STARTTLS=true
#   SMTP_USER: el login que da Brevo en SMTP & API (algo como xxxxxxx@smtp-brevo.com),
#              NO tu correo.
#   SMTP_PASSWORD: la clave SMTP de Brevo (no la contraseña de la cuenta).
#
# Tres cosas que hacen fallar el envío con credenciales perfectamente válidas:
#   · Muchos proveedores de VPS (netcup, Hetzner, OVH…) BLOQUEAN el SMTP saliente
#     (25/465/587) de serie. El síntoma es un "timed out" que no dice su causa.
#   · Brevo permite restringir el acceso POR IP: da de alta la del servidor.
#   · El dominio de SMTP_FROM debe estar VERIFICADO en Brevo (un TXT brevo-code en el
#     DNS). Con eso, Brevo se encarga de la autenticación del correo (SPF/DKIM).
# Estas credenciales son de despliegue: nunca se exportan.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
# Dirección remitente (From), la que ve la familia. De un dominio verificado en el relé.
SMTP_FROM=
SMTP_STARTTLS=true

# Nombre visible del remitente ("MundoAventura <no-reply@tudominio.com>").
# Vacío = se muestra solo la dirección.
EMAIL_FROM_NAME=MundoAventura


# ─── COPIAS DE SEGURIDAD DEL SERVIDOR (solo VPS) ────────────────────
# Destinatario GPG con el que se CIFRAN las copias (la nocturna y la de
# predespliegue). El tarball lleva ESTE MISMO fichero dentro, así que en claro
# entrega de una vez las claves de los cinco proveedores y el SMTP.
#
# Se cifra con CLAVE PÚBLICA a propósito: el servidor puede crear copias pero no
# leerlas, porque la clave privada nunca ha estado en la máquina. Vacío = copias sin
# cifrar y un aviso por stderr; en local, donde no se hacen copias, es indiferente.
#
# IMPORTA LA CLAVE ANTES de rellenar esto. Si está puesto y GPG no puede cifrar
# (clave sin importar, nombre mal escrito), respaldar.sh sale con error a propósito
# —no deja una copia en claro— y eso aborta el despliegue ANTES del git pull: el
# único caso en el que el despliegue automático NO puede repararse solo. La receta
# y la comprobación previa están en docs/DESPLIEGUE.md §5.2.
BACKUP_GPG_RECIPIENT=


# ─── DESARROLLO ─────────────────────────────────────────────────────
# Si está activo (true), el BACKEND imprime en SU consola (uvicorn) trazas de
# diagnóstico: el origen de cada respuesta del chat
# (🟢 RAG = fundamentada en la enciclopedia · 🟡 GENERAL = conocimiento del modelo)
# y los prompts enviados al LLM, a la generación de imagen y a DeepL. Solo afecta a
# la consola del backend: el niño NO ve nada distinto. Para la versión final del
# usuario, déjalo en false.
# (El botón "🔌 Probar conexión" del frontend se activa aparte con VITE_DEBUG=true
#  en frontend-react/.env, no con esta variable.)
DEBUG=false

# El desplegable "📚 ¿De dónde lo he sacado?" del chat (los fragmentos que se usaron
# para responder) NO lo controla DEBUG desde el Hito 4.2, sino este flag propio:
# enseñar la procedencia es pedagogía, no depuración. También es editable en caliente
# desde 🛡️ Admin → IA (grupo "prompts").
MOSTRAR_FUENTES=false

# Nivel de logging del backend: DEBUG | INFO | WARNING | ERROR (por defecto INFO).
# Controla el DETALLE de los logs; es independiente de DEBUG (que es un flag de
# producto: traza los prompts del RAG en la consola). Al activar DEBUG,
# el logger del backend baja a DEBUG automáticamente para que se vean esas trazas.
LOG_LEVEL=INFO
