# URL del backend FastAPI.
#
# - En DESARROLLO local puede dejarse vacía o sin definir: el proxy de
#   vite.config.ts ya redirige /api y /health a http://127.0.0.1:8000,
#   así que el navegador habla siempre con el mismo origen (sin CORS).
# - Con el backend en COLAB, poner aquí la URL https del túnel
#   (ej. https://xxxx.ngrok-free.app), sin barra final.
#
# Copiar este archivo a .env (o .env.local) y ajustar el valor.
VITE_BACKEND_URL=http://127.0.0.1:8000

# Modo desarrollo: con "true" aparece el botón "🔌 Probar conexión" en la
# cabecera (como el DEBUG de la app Flet). Dejar sin definir (o "false")
# en la versión para el niño.
VITE_DEBUG=false

# Código de acceso del túnel (Hito 2). Debe COINCIDIR con ACCESS_CODE del backend.
# Si el backend tiene ACCESS_CODE configurado, los endpoints del niño exigen este
# valor en la cabecera X-Access-Code. Vacío = el backend no tiene candado (dev).
VITE_ACCESS_CODE=
