# Ficheros que se ejecutan en LINUX (el VPS) pero se editan en Windows.
# Sin esto, git puede dejarlos con finales de línea CRLF al hacer checkout en el
# servidor y el shebang `#!/usr/bin/env bash\r` falla con "bad interpreter".
*.sh              text eol=lf
*.service         text eol=lf
*.socket          text eol=lf
deploy/Caddyfile  text eol=lf
