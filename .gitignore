# ─── Entornos virtuales de Python ───────────────────────────────
# No versionamos el venv: cada máquina recrea el suyo con los requirements.
venv/
.venv/
env/

# ─── Cachés y temporales de Python ──────────────────────────────
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.ruff_cache/

# ─── Cobertura de tests (pytest-cov) ────────────────────────────
.coverage
coverage.xml
htmlcov/

# ─── Variables de entorno ───────────────────────────────────────
# .env contiene configuración local (URLs, rutas). Solo se versiona .env.example.
.env

# ─── Modelos de IA (pesados) ────────────────────────────────────
# Los pesos de los modelos NO se suben al repositorio (pesan cientos de MB).
# Stable Diffusion se cachea en la caché de Hugging Face, no aquí.
backend/models/*.pth
backend/models/*.pt
backend/models/*.safetensors

# ─── Base vectorial de ChromaDB (se regenera con: python -m backend.ingest) ─
backend/chroma_db/

# ─── BBDD de configuración (SQLite) — se recrea y se siembra al arrancar ─────
# Contiene ajustes/catálogo locales de cada instalación; no se versiona.
backend/config_db.sqlite3
backend/*.sqlite3
# Copias de seguridad automáticas (SQLite antes de importar; .env al guardar claves).
backend/*.sqlite3.*.bak
.env.bak
.env.*.bak

# ─── Salidas / archivos generados durante pruebas ───────────────
*.log
outputs/

# ─── Sistema operativo / editores ───────────────────────────────
.DS_Store
Thumbs.db
.idea/
.vscode/

# ─── Claude Code / Playwright MCP ────────────────────────────────
# Snapshots y logs de consola que deja cada navegación del MCP de Playwright.
.playwright-mcp/

# Evals: los resultados de cada corrida no se versionan (salvo la línea base).
evals/resultados/*
!evals/resultados/BASELINE.csv
